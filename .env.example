# ============================================================
#  Admin authentication
# ============================================================
# Username for the /admin login.
ADMIN_USERNAME=admin

# Choose ONE of the following password options:

# Option A (simple) — plaintext password.
ADMIN_PASSWORD=change-this-password

# Option B (recommended) — scrypt hash. Takes precedence over ADMIN_PASSWORD.
# Generate with:  node scripts/hash-password.mjs 'your-strong-password'
# ADMIN_PASSWORD_HASH=scrypt:<saltHex>:<hashHex>

# Secret used to sign the admin session JWT. Use a long random string (32+ chars).
# Generate with:  openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret-string

# ============================================================
#  Google AdSense (optional)
# ============================================================
# Your publisher ID, e.g. ca-pub-1234567890123456.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
