# ---- Admin authentication ----
# Username for the /admin login.
ADMIN_USERNAME=admin
# Password for the /admin login. CHANGE THIS in production.
ADMIN_PASSWORD=change-this-password
# Secret used to sign the admin session JWT. Use a long random string (32+ chars).
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret-string

# ---- Google AdSense (optional) ----
# Your publisher ID, e.g. ca-pub-1234567890123456 (used when you wire the loader).
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
